---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This OH Moments page doesn't exist." path="/404">
<section class="mx-auto max-w-2xl px-4 py-20 text-center">
<p class="serif text-7xl metallic-text font-semibold" aria-hidden="true">oh</p>
<h1 class="mt-4 text-4xl font-semibold">That moment wasn't found</h1>
<p class="mt-3 text-[#69727D]">The link may be old or mistyped.</p>
<div class="mt-6 flex justify-center gap-3">
<a href="/" class="rounded-full bg-[#12284A] px-6 py-2.5 text-sm font-medium text-white">Home</a>
<a href="/products" class="rounded-full border border-[#12284A] px-6 py-2.5 text-sm font-medium text-[#12284A]">Shop</a>
</div>
</section>
</Base>
