---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { BRANDS, SITE, whatsappLink } from '../../data/brands';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return BRANDS.map((b) => ({ params: { brand: b.slug }, props: { brand: b } }));
}
const { brand } = Astro.props;
const all = await getCollection('products');
const slugOf = (id: string) => id.replace(/\.json$/, '').split('/').pop() as string;
const items = all.filter(p => p.data.brand === brand.slug);
const isCatalogue = brand.kind === 'catalogue';
const msg = `Hello OH Moments! I'd like ${isCatalogue ? 'to enquire about ' + brand.name : 'a quote from ' + brand.name + ' (' + brand.tag + ')'}.`;
---
<Base title={brand.name} description={`${brand.name} — ${brand.tag}. ${brand.blurb}`} path={`/brands/${brand.slug}`} image={brand.image}>
<section class="relative overflow-hidden bg-[#0c1c34] text-white">
<img src={brand.image} alt={`${brand.name} — ${brand.tag}`} width="1200" height="800" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" />
<div class="absolute inset-0 bg-gradient-to-r from-[#0c1c34]/85 via-[#0c1c34]/40 to-transparent" aria-hidden="true"></div>
<div class="relative mx-auto max-w-6xl px-4 py-14 md:py-20 [text-shadow:0_2px_24px_rgba(12,28,52,.55)]">
<p class="eyebrow text-[#D9C9A5]">{brand.tag}</p>
<h1 class="display mt-2 font-semibold text-white">{brand.name}</h1>
<p class="mt-4 max-w-xl leading-relaxed text-white/85">{brand.intro}</p>
<div class="mt-6 flex flex-col sm:flex-row sm:flex-wrap gap-3">
<a href={`/contact?brand=${brand.slug}`} class="rounded-full bg-white px-7 py-3.5 text-center text-xs font-medium uppercase tracking-[0.16em] text-[#12284A] hover:bg-[#F5F0E6] w-full sm:w-auto">{isCatalogue ? 'Enquire' : 'Request a quote'}</a>
<a href={whatsappLink(msg)} target="_blank" rel="noopener" class="rounded-full border border-[#D9C9A5] px-7 py-3.5 text-center text-xs font-medium uppercase tracking-[0.16em] text-white hover:bg-white/10 w-full sm:w-auto">WhatsApp</a>
</div>
</div>
</section>

{isCatalogue ? (
<section class="mx-auto max-w-6xl px-4 py-12 md:py-16">
<h2 class="serif text-3xl font-semibold uppercase tracking-[0.03em]">{brand.name} catalogue</h2>
{brand.slug === 'moments-touch' && (
<div class="mt-4 rounded-2xl border border-[#D9C9A5] bg-[#F5F0E6] p-5 text-sm leading-relaxed" role="note">
<p><strong>A note on bleach care:</strong> a little goes a long way — always follow label directions, ventilate rooms while cleaning, never mix with other chemicals, and store safely out of reach of children and pets.</p>
</div>
)}
{items.length === 0 ? (
<p class="mt-6 text-[#69727D]">New pieces arriving soon — enquire on WhatsApp for what is available now.</p>
) : (
<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
{items.map(p => <ProductCard slug={slugOf(p.id)} name={p.data.name} brandName={brand.name} brandSlug={brand.slug} shortDescription={p.data.shortDescription} price={p.data.price} inStock={p.data.inStock} image={p.data.images[0] ?? brand.image} />)}
</div>
)}
</section>
) : (
<section class="mx-auto max-w-6xl px-4 py-12 md:py-16 grid gap-10 md:grid-cols-[1fr_.9fr]">
<div>
<h2 class="serif text-3xl font-semibold uppercase tracking-[0.03em]">What we offer</h2>
<ul class="mt-5 space-y-3">
{(brand.offers ?? []).map(o => <li class="flex gap-3 rounded-2xl border border-[#D9C9A5] bg-white p-4 text-[15px]"><span class="text-[#B8862F]" aria-hidden="true">◆</span><span>{o}</span></li>)}
</ul>
{brand.howTo && (
<>
<h3 class="serif mt-8 text-2xl font-semibold uppercase tracking-[0.04em]">How enquiries work</h3>
<ol class="mt-3 space-y-2.5 text-[15px]">
{brand.howTo.map((s, i) => <li class="flex gap-3"><span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-[#12284A] text-xs font-medium text-white">{i + 1}</span><span>{s}</span></li>)}
</ol>
</>
)}
<div class="mt-7 flex flex-wrap gap-3">
<a href={`/contact?brand=${brand.slug}`} class="rounded-full bg-[#12284A] px-7 py-3 text-xs font-medium uppercase tracking-[0.16em] text-white">Request a quote</a>
<a href={whatsappLink(msg)} target="_blank" rel="noopener" class="rounded-full border border-[#12284A] px-7 py-3 text-xs font-medium uppercase tracking-[0.16em] text-[#12284A]">WhatsApp</a>
</div>
</div>
<div>
<div class="overflow-hidden rounded-[28px] border border-[#D9C9A5]">
<img src={brand.image} alt={`${brand.name} — project photography`} width="1200" height="800" loading="lazy" class="aspect-[4/3] w-full object-cover" />
</div>
<p class="mt-3 text-xs text-[#69727D]">{brand.galleryNote}</p>
</div>
</section>
)}
<section class="mx-auto max-w-6xl px-4 pb-12 text-sm text-[#69727D]">
<p>Part of <a class="text-[#12284A] underline underline-offset-4" href="/">OH Moments</a> · {SITE.location} · <a class="text-[#12284A] underline" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
</section>
</Base>
