---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import BrandCard from '../components/BrandCard.astro';
import ProductCard from '../components/ProductCard.astro';
import { BRANDS, SITE, brandBySlug, whatsappLink } from '../data/brands';
import { getCollection } from 'astro:content';

const all = await getCollection('products');
const slugOf = (id: string) => id.replace(/\.json$/, '').split('/').pop() as string;
const bname = (s: string) => brandBySlug(s)?.name ?? s;
const bimg = (s: string) => brandBySlug(s)?.image ?? '/img/real/hero.jpg';
const featured = all.filter(p => p.data.featured).slice(0, 4);
---
<Base title="OH Moments — Something your home needs" description="OH Moments is a Johannesburg lifestyle destination: Pretty Plate_Co tableware, Moments Touch bleach cleaner, Legae renovations and solar, Shaded curtains and blinds, Blooms flowers and intimate occasions." path="/" image="/img/real/hero.jpg">
<!-- HERO -->
<section class="relative overflow-hidden bg-[#0c1c34] text-white">
<img src="/img/real/hero.jpg" alt="Elegant neutral living room with considered details" width="1600" height="1000" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" />
<div class="absolute inset-0 bg-gradient-to-r from-[#0c1c34]/90 via-[#0c1c34]/40 to-transparent" aria-hidden="true"></div>
<div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28 [text-shadow:0_2px_24px_rgba(12,28,52,.55)]">
<p class="eyebrow text-[#D9C9A5]">Johannesburg · Lifestyle · Home</p>
<h1 class="display mt-4 max-w-2xl font-semibold text-white">Something your home <em class="metallic-text not-italic">needs.</em></h1>
<p class="mt-5 max-w-md leading-relaxed text-white/85">One parent brand, five considered businesses — tableware, bleach cleaner, curtains, renovations and solar, flowers and intimate occasions.</p>
<div class="mt-8 flex flex-col sm:flex-row sm:flex-wrap gap-3">
<a href="/products" class="rounded-full bg-white px-8 py-3.5 text-center text-xs font-medium uppercase tracking-[0.18em] text-[#12284A] hover:bg-[#F5F0E6] w-full sm:w-auto">Shop the collections</a>
<a href={whatsappLink("Hello OH Moments! I'd like to find out more.")} target="_blank" rel="noopener" class="rounded-full border border-[#D9C9A5] px-8 py-3.5 text-center text-xs font-medium uppercase tracking-[0.18em] text-white hover:bg-white/10 w-full sm:w-auto">WhatsApp us</a>
</div>
<div class="gold-rule mt-10 max-w-sm" aria-hidden="true"></div>
<p class="mt-3 text-[11px] uppercase tracking-[0.22em] text-[#D9C9A5]/90">Pretty Plate_Co · Moments Touch · Legae · Shaded · Blooms and Occasions</p>
</div>
</section>

<!-- BRAND MARK -->
<section class="border-b border-[#D9C9A5] bg-white">
<div class="mx-auto max-w-6xl px-4 py-12 grid gap-8 md:grid-cols-2 md:items-center">
<div class="logo-crop mx-auto w-full max-w-md overflow-hidden rounded-[28px] border border-[#D9C9A5] bg-white">
<Image src={logo} alt="OH Moments — gold oh monogram with home interior" width={800} height={709} format="webp" class="h-full w-full" />
</div>
<div class="text-center md:text-left">
<p class="eyebrow text-[#69727D]">The mark of considered living</p>
<p class="serif mt-3 text-3xl md:text-4xl italic leading-snug text-[#12284A]">“Beautifully sourced products. Thoughtfully curated experiences. Moments made memorable.”</p>
<p class="mt-4 text-[11px] uppercase tracking-[0.28em] text-[#69727D]">{SITE.tagline}</p>
</div>
</div>
</section>

<!-- BRANDS -->
<section class="mx-auto max-w-6xl px-4 py-16 md:py-24">
<div class="flex flex-wrap items-end justify-between gap-4">
<div>
<p class="eyebrow text-[#69727D]">Five businesses · one home</p>
<h2 class="h2 mt-2 font-semibold">A curated luxury destination</h2>
</div>
<a href="/products" class="text-sm font-medium uppercase tracking-[0.14em] text-[#12284A] underline underline-offset-8">Shop all</a>
</div>
<div class="mt-10 grid gap-6 md:grid-cols-2">
{BRANDS.slice(0, 2).map(b => <BrandCard brand={b} large={true} />)}
{BRANDS.slice(2).map(b => <BrandCard brand={b} />)}
<a href="/products" class="card-lift grid place-items-center rounded-3xl bg-[#12284A] p-10 text-center text-white hover:bg-[#0c1c34]">
<span><span class="eyebrow text-[#D9C9A5]">All together</span><span class="serif mt-3 block text-3xl md:text-4xl">Shop every product</span><span class="mt-4 inline-block rounded-full border border-[#D9C9A5] px-6 py-2 text-xs uppercase tracking-[0.18em]">Enter the shop</span></span>
</a>
</div>
</section>

<!-- FEATURED -->
<section class="bg-[#F5F0E6] border-y border-[#D9C9A5]">
<div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
<p class="eyebrow text-[#69727D]">Featured · catalogue and lead enquiries</p>
<h2 class="h2 mt-2 font-semibold">Loved for considered homes</h2>
<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
{featured.map(p => <ProductCard slug={slugOf(p.id)} name={p.data.name} brandName={bname(p.data.brand)} brandSlug={p.data.brand} shortDescription={p.data.shortDescription} price={p.data.price} inStock={p.data.inStock} image={p.data.images[0] ?? bimg(p.data.brand)} />)}
</div>
</div>
</section>

<!-- LEGAE FEATURE -->
<section class="mx-auto max-w-6xl px-4 py-16 md:py-24 grid gap-10 md:grid-cols-2 md:items-center">
<div class="overflow-hidden rounded-[28px] border border-[#D9C9A5] shadow-[0_30px_80px_-40px_rgba(18,40,74,.45)]">
<img src="/img/real/renovation.jpg" alt="Refined renovated home interior" width="1200" height="800" loading="lazy" class="aspect-[4/3] w-full object-cover" />
</div>
<div>
<p class="eyebrow text-[#69727D]">Legae · home renovations and solar</p>
<h2 class="h2 mt-2 font-semibold">Refresh your space. Future-proof your power.</h2>
<p class="mt-4 leading-relaxed">From room refreshes to solar enquiries — clear scopes, written quotes and dependable communication. Solar solutions and installation enquiries are subject to client confirmation; no products, certifications or warranties are implied until confirmed.</p>
<div class="mt-6 overflow-hidden rounded-2xl border border-[#D9C9A5]">
<img src="/img/real/solar.jpg" alt="Rooftop solar panels" width="1200" height="800" loading="lazy" class="aspect-[16/8] w-full object-cover" />
<p class="bg-[#12284A] px-4 py-2 text-[11px] uppercase tracking-[0.18em] text-[#D9C9A5]">Solar enquiries — subject to confirmation</p>
</div>
<div class="mt-6 flex flex-wrap gap-3">
<a href="/brands/legae" class="rounded-full bg-[#12284A] px-7 py-3 text-xs font-medium uppercase tracking-[0.16em] text-white">Explore Legae</a>
<a href="/contact?brand=legae" class="rounded-full border border-[#12284A] px-7 py-3 text-xs font-medium uppercase tracking-[0.16em] text-[#12284A]">Request a quotation</a>
</div>
</div>
</section>

<!-- VALUES -->
<section class="bg-[#12284A] text-white">
<div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
<p class="eyebrow text-[#D9C9A5]">Quality · Beauty · Reliability · Creativity</p>
<h2 class="serif mt-2 max-w-2xl text-3xl md:text-4xl text-white font-semibold uppercase tracking-[0.03em]">Beautiful details transform everyday living</h2>
<div class="mt-10 grid gap-5 md:grid-cols-4">
{[['Quality','Thoughtfully selected products with value, finish and practicality in mind.'],['Beauty','Details that elevate spaces, tables and occasions.'],['Reliability','Clear communication and dependable service.'],['Creativity','Fresh ideas that help customers create their own moments.']].map(([t,d]) => (
<div class="rounded-3xl border border-[#D9C9A5]/25 bg-white/[0.03] p-7"><div class="h-px w-10 bg-[#D4A94A]" aria-hidden="true"></div><h3 class="serif mt-4 text-2xl text-white uppercase tracking-[0.06em]">{t}</h3><p class="mt-2 text-sm leading-relaxed text-white/80">{d}</p></div>
))}
</div>
<blockquote class="mx-auto mt-12 max-w-3xl text-center">
<p class="serif text-2xl md:text-[2rem] italic leading-snug text-[#F5F0E6]">“Beautifully sourced products. Thoughtfully curated experiences. Moments made memorable.”</p>
</blockquote>
</div>
</section>

<!-- CONTACT -->
<section class="mx-auto max-w-6xl px-4 py-16 md:py-20 grid gap-8 md:grid-cols-2 md:items-center">
<div>
<p class="eyebrow text-[#69727D]">Contact and enquiry</p>
<h2 class="h2 mt-2 font-semibold">Product, bulk, quote or booking?</h2>
<p class="mt-4 leading-relaxed">One shared experience: product and bulk enquiries, renovation and solar quotations, curtain and blind enquiries, floral and occasion bookings.</p>
<div class="mt-7 flex flex-wrap gap-3">
<a href="/contact" class="rounded-full bg-[#12284A] px-8 py-3.5 text-xs font-medium uppercase tracking-[0.16em] text-white">Send an enquiry</a>
<a href={whatsappLink("Hello OH Moments! I'd like to make an enquiry.")} target="_blank" rel="noopener" class="rounded-full border border-[#12284A] px-8 py-3.5 text-xs font-medium uppercase tracking-[0.16em] text-[#12284A]">WhatsApp {SITE.whatsappDisplay}</a>
</div>
</div>
<div class="overflow-hidden rounded-[28px] border border-[#D9C9A5]">
<img src="/img/real/dining.jpg" alt="Beautifully set table for a memorable occasion" width="1200" height="800" loading="lazy" class="aspect-[16/10] w-full object-cover" />
<div class="bg-[#F5F0E6] p-7">
<p class="eyebrow text-[#69727D]">Customer promise</p>
<p class="serif mt-2 text-xl italic text-[#12284A]">Making the everyday feel worth remembering.</p>
</div>
</div>
</section>
</Base>
